+//===--------------------------------------------------------------------===//
+// Page-level seeking
+//===--------------------------------------------------------------------===//
+void ColumnReader::ReadPageHeader(PageHeader &page_hdr) {
+	auto &trans = reinterpret_cast<ThriftFileTransport &>(*protocol->getTransport());
+	if (trans.HasPrefetch()) {
+		Read(page_hdr);
+		return;
+	}
+	static constexpr idx_t ASSUMED_HEADER_SIZE = 256;
+	trans.Prefetch(trans.GetLocation(), MinValue(trans.GetSize() - trans.GetLocation(), ASSUMED_HEADER_SIZE));
+	Read(page_hdr);
+	trans.ClearPrefetch();
+}
+
+void ColumnReader::LoadOffsetIndex() {
+	if (offset_index_loaded) {
+		return;
+	}
+	offset_index_loaded = true;
+	if (!chunk->__isset.offset_index_offset || !chunk->__isset.offset_index_length ||
+	    chunk->offset_index_length <= 0) {
+		return;
+	}
+	auto &trans = reinterpret_cast<ThriftFileTransport &>(*protocol->getTransport());
+	if (trans.HasPrefetch()) {
+		return;
+	}
+	const auto location = trans.GetLocation();
+	const auto index_offset = NumericCast<idx_t>(chunk->offset_index_offset);
+	const auto index_length = NumericCast<idx_t>(chunk->offset_index_length);
+	if (index_offset + index_length > trans.GetSize()) {
+		return;
+	}
+	auto index = make_uniq<duckdb_parquet::OffsetIndex>();
+	try {
+		trans.SetLocation(index_offset);
+		trans.Prefetch(index_offset, index_length);
+		reader.Read(*index, *protocol);
+		offset_index = std::move(index);
+	} catch (std::exception &) {
+		// A malformed index only disables the fast path; header walking still works.
+	}
+	trans.ClearPrefetch();
+	trans.SetLocation(location);
+}
+
+bool ColumnReader::OffsetIndexRows(idx_t page_offset, idx_t &rows) const {
+	if (!offset_index) {
+		return false;
+	}
+	auto &locations = offset_index->page_locations;
+	auto entry = std::lower_bound(
+	    locations.begin(), locations.end(), page_offset,
+	    [](const duckdb_parquet::PageLocation &location, idx_t offset) { return idx_t(location.offset) < offset; });
+	if (entry == locations.end() || idx_t(entry->offset) != page_offset || entry + 1 == locations.end() ||
+	    (entry + 1)->first_row_index < entry->first_row_index) {
+		return false;
+	}
+	rows = NumericCast<idx_t>((entry + 1)->first_row_index - entry->first_row_index);
+	return true;
+}
+
+idx_t ColumnReader::CountRowStarts(PageHeader &page_hdr) {
+	// V1 levels live inside the compressed payload. Decompress, then decode repetition levels only.
+	// Use a fresh block: a string dictionary may still reference the previous one.
+	block.reset();
+	PreparePage(page_hdr);
+	ByteBuffer buffer(block->ptr, NumericCast<idx_t>(page_hdr.uncompressed_page_size));
+	const auto levels_length = buffer.read<uint32_t>();
+	buffer.available(levels_length);
+	RleBpDecoder decoder(buffer.ptr, levels_length, RleBpDecoder::ComputeBitWidth(MaxRepeat()));
+	data_t levels[STANDARD_VECTOR_SIZE];
+	idx_t remaining = NumericCast<idx_t>(page_hdr.data_page_header.num_values);
+	idx_t starts = 0;
+	while (remaining > 0) {
+		const auto batch = MinValue<idx_t>(remaining, STANDARD_VECTOR_SIZE);
+		decoder.GetBatch<uint8_t>(levels, NumericCast<uint32_t>(batch));
+		for (idx_t i = 0; i < batch; i++) {
+			starts += levels[i] == 0;
+		}
+		remaining -= batch;
+	}
+	return starts;
+}
+
+idx_t ColumnReader::SkipWholePages(idx_t rows) {
+	// Only leaf readers at a page boundary qualify. Nested repetition and encryption use the decoding path.
+	if (!chunk || rows == 0 || page_rows_available != 0 || pending_skips != 0 || MaxRepeat() > 1 ||
+	    reader.parquet_options.encryption_config || chunk->__isset.crypto_metadata) {
+		return 0;
+	}
+	auto &trans = reinterpret_cast<ThriftFileTransport &>(*protocol->getTransport());
+	const bool repeated = MaxRepeat() > 0;
+	if (repeated) {
+		LoadOffsetIndex();
+	}
+	const idx_t chunk_end = FileOffset() + NumericCast<idx_t>(chunk->meta_data.total_compressed_size);
+	idx_t skipped_rows = 0;
+	idx_t skipped_values = 0;
+	trans.SetLocation(chunk_read_offset);
+	while (skipped_rows < rows && trans.GetLocation() < chunk_end) {
+		const auto page_start = trans.GetLocation();
+		PageHeader page_hdr;
+		ReadPageHeader(page_hdr);
+		if (page_hdr.compressed_page_size < 0 || page_hdr.uncompressed_page_size < 0) {
+			trans.SetLocation(page_start);
+			break;
+		}
+		const auto page_end = trans.GetLocation() + NumericCast<idx_t>(page_hdr.compressed_page_size);
+		if (page_hdr.type == PageType::DICTIONARY_PAGE) {
+			// Later pages need the dictionary, so load it through the regular path.
+			trans.SetLocation(page_start);
+			PrepareRead(nullptr, nullptr);
+			continue;
+		}
+		if (page_hdr.type != PageType::DATA_PAGE && page_hdr.type != PageType::DATA_PAGE_V2) {
+			trans.SetLocation(page_end);
+			continue;
+		}
+		const bool v1 = page_hdr.type == PageType::DATA_PAGE;
+		const auto values = v1 ? page_hdr.data_page_header.num_values : page_hdr.data_page_header_v2.num_values;
+		if (values < 0 || (!v1 && page_hdr.data_page_header_v2.num_rows < 0)) {
+			trans.SetLocation(page_start);
+			break;
+		}
+		idx_t page_rows = NumericCast<idx_t>(values);
+		if (repeated && !v1) {
+			// V2 pages always start at a row boundary and record their row count.
+			page_rows = NumericCast<idx_t>(page_hdr.data_page_header_v2.num_rows);
+		} else if (repeated && !OffsetIndexRows(page_start, page_rows)) {
+			page_rows = CountRowStarts(page_hdr);
+		}
+		if (skipped_rows + page_rows > rows) {
+			trans.SetLocation(page_start);
+			break;
+		}
+		trans.SetLocation(page_end);
+		skipped_rows += page_rows;
+		skipped_values += NumericCast<idx_t>(values);
+	}
+	if (skipped_values > group_rows_available) {
+		throw InvalidInputException("Failed to read file \"%s\": page values exceed the column chunk value count",
+		                            Reader().GetFileName());
+	}
+	chunk_read_offset = trans.GetLocation();
+	group_rows_available -= skipped_values;
+	return skipped_rows;
 }
 
